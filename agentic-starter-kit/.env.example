# ---- LLM provider (pick one; profile is selected by LLM_PROVIDER) ----
LLM_PROVIDER=echo                # echo | openai | azure_openai | anthropic
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

OPENAI_API_KEY=
OPENAI_BASE_URL=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=

ANTHROPIC_API_KEY=

# Resilience: retry transient failures (429/5xx/timeouts), then open a circuit
# breaker rather than hammering a provider that is persistently down.
LLM_RETRY_ENABLED=true
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=0.5
LLM_RETRY_MAX_DELAY=20
LLM_BREAKER_THRESHOLD=5
LLM_BREAKER_RESET_SECONDS=30

# ---- Observability ----
OBSERVABILITY_PROVIDER=none      # none | langfuse | otel
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# OpenTelemetry (pip install '.[otel]'). Puts agent spans in the same
# waterfall as the rest of your platform.
OTEL_SERVICE_NAME=starter-agent
OTEL_EXPORTER_ENDPOINT=          # OTLP/HTTP, e.g. http://collector:4318/v1/traces
OTEL_CONSOLE=false               # print spans locally when no collector is set

# ---- Memory ----
MEMORY_BACKEND=in_memory         # in_memory | file | cosmos | vector
MEMORY_DIR=.memory
COSMOS_ENDPOINT=
COSMOS_DATABASE=agentmem
COSMOS_CONTAINER=threads
SHORT_TERM_MAX_TURNS=20
SUMMARY_TRIGGER_TURNS=12

# Retrieval. hashing is offline/deterministic but bag-of-words, not semantic.
EMBEDDING_PROVIDER=hashing       # hashing | openai | azure_openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DEPLOYMENT=
EMBEDDING_DIMENSIONS=256
HYBRID_ALPHA=0.7                 # alpha*cosine + (1-alpha)*lexical
SEARCH_ENDPOINT=                 # set to use Azure AI Search for long-term memory
SEARCH_INDEX=agent-memory

# ---- Guardrails ----
GUARDRAILS_POLICY=config/guardrails.yaml
GUARDRAILS_FAIL_MODE=block       # block | flag

# ---- Agent loop ----
AGENT_MAX_ITERATIONS=8
AGENT_WALL_CLOCK_SECONDS=120
AGENT_MAX_TOOL_CALLS=16
# Stream draft tokens. Off by default: tokens sent before the output
# guardrails run cannot be unsent. Clients must honour the final answer event.
AGENT_STREAM_TOKENS=false

# ---- Rate limits and quotas ----
# The in-memory limiter is per replica: N replicas allow N x the limit. Use a
# shared QuotaStore (Redis/Cosmos) before relying on these for billing.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10
QUOTA_REQUESTS_PER_DAY=0         # 0 disables
QUOTA_TOKENS_PER_DAY=0           # 0 disables

# ---- Service ----
APP_ENV=local
LOG_LEVEL=INFO
