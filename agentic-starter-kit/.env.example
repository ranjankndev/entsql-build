# ---- LLM provider (pick one; profile is selected by LLM_PROVIDER) ----
LLM_PROVIDER=echo                # echo | openai | azure_openai | anthropic
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

OPENAI_API_KEY=
OPENAI_BASE_URL=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=

ANTHROPIC_API_KEY=

# ---- Observability ----
OBSERVABILITY_PROVIDER=none      # none | langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Memory ----
MEMORY_BACKEND=in_memory         # in_memory | file | cosmos
MEMORY_DIR=.memory
COSMOS_ENDPOINT=
COSMOS_DATABASE=agentmem
COSMOS_CONTAINER=threads
SHORT_TERM_MAX_TURNS=20
SUMMARY_TRIGGER_TURNS=12

# ---- Guardrails ----
GUARDRAILS_POLICY=config/guardrails.yaml
GUARDRAILS_FAIL_MODE=block       # block | flag

# ---- Agent loop ----
AGENT_MAX_ITERATIONS=8
AGENT_WALL_CLOCK_SECONDS=120
AGENT_MAX_TOOL_CALLS=16

# ---- Service ----
APP_ENV=local
LOG_LEVEL=INFO
